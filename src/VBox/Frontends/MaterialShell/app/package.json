{
  "name": "material-virtualbox-shell",
  "productName": "Material Virtual Machine",
  "version": "7.2.97",
  "description": "Material 3 Expressive front end for VirtualBox, driving the Main API through VBoxMaterialBridge.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "main/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "package:win": "electron-packager . MaterialVirtualMachine --platform=win32 --arch=x64 --out=out --overwrite --prune=true --ignore=^/test --ignore=^/out"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.1"
  }
}
